+fn positive_axis_isolation_preserves_close_rational_roots_and_multiplicities() {
+    use crate::domains::{integer::Integer, rational::Rational};
+    let p = parse!("x^4*(x+2)^3*(x-1)^2*(2^80*x-1)*(2^80*x-2)*(x^2+1)")
+        .to_polynomial::<_, u16>(&Z, None)
+        .to_univariate_from_univariate(0);
+    let roots = p.isolate_positive_real_root_intervals();
+    let expected: Vec<(Rational, usize)> = vec![
+        ((Integer::one(), Integer::from(2).pow(80)).into(), 1),
+        ((Integer::one(), Integer::from(2).pow(79)).into(), 1),
+        (Rational::one(), 2),
+    ];
+    assert_eq!(roots.len(), expected.len());
+    assert!(roots.windows(2).all(|r| r[0].1 <= r[1].0));
+    for ((lo, hi, multiplicity), (root, expected_multiplicity)) in
+        roots.into_iter().zip(expected)
+    {
+        assert!(lo <= root && root <= hi);
+        assert!(lo >= Rational::zero() && hi > Rational::zero());
+        assert_eq!(multiplicity, expected_multiplicity);
+        assert!(p.map_coeff(|c| c.to_rational(), Q).evaluate(&root).is_zero());
+    }
