+#[test]
+fn positive_axis_isolation_handles_rational_content_and_constants() {
+    let p = parse!("-3/7*x^2*(x+2)^3*(x-1)^2*(x^2-2)")
+        .to_polynomial::<_, u16>(&Q, None)
+        .to_univariate_from_univariate(0);
+    let positive = p.isolate_positive_real_root_intervals();
+    let full: Vec<_> = p
+        .isolate_real_root_intervals()
+        .into_iter()
+        .filter(|(_, hi, _)| hi > &crate::domains::rational::Rational::zero())
+        .collect();
+    assert_eq!(positive.len(), 2);
+    assert_eq!(positive.iter().map(|r| r.2).collect::<Vec<_>>(), [2, 1]);
+    for ((lo, hi, multiplicity), (old_lo, old_hi, old_multiplicity)) in
+        positive.into_iter().zip(full)
+    {
+        assert!(lo <= old_hi && old_lo <= hi);
+        assert_eq!(multiplicity, old_multiplicity);
+    }
+    assert!(p.zero().isolate_positive_real_root_intervals().is_empty());
+    assert!(p.one().isolate_positive_real_root_intervals().is_empty());
+    let z = parse!("x").to_polynomial::<_, u16>(&Z, None)
+        .to_univariate_from_univariate(0);
+    assert!(z.zero().isolate_positive_real_root_intervals().is_empty());
+    assert!(z.one().isolate_positive_real_root_intervals().is_empty());
+}
