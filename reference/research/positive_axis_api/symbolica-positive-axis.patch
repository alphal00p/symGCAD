+#[test]
+fn positive_axis_isolation_matches_full_inventory_across_factors() {
+    use crate::domains::rational::Rational;
+    for expression in [
+        "(x^2-2)^3*(x^2-3)^2*x^2",
+        "(x+1)^3*(x+2)^2",
+        "x^3+x+1",
+        "x^2+1",
+        "-x*(x-1)*(x+1)",
+        "x^5",
+        "2^100*x-1",
+        "x-2^100",
+    ] {
+        let p = parse!(expression)
+            .to_polynomial::<_, u16>(&Z, None)
+            .to_univariate_from_univariate(0);
+        let full: Vec<_> = p
+            .isolate_real_root_intervals()
+            .into_iter()
+            .filter(|(_, hi, _)| hi > &Rational::zero())
+            .collect();
+        let positive = p.isolate_positive_real_root_intervals();
+        assert_eq!(positive.len(), full.len(), "{expression}");
+        assert!(positive.windows(2).all(|r| r[0].1 <= r[1].0));
+        for ((lo, hi, multiplicity), (old_lo, old_hi, old_multiplicity)) in
+            positive.into_iter().zip(full)
+        {
+            assert_eq!(multiplicity, old_multiplicity);
+            assert!(lo <= old_hi && old_lo <= hi, "{expression}");
+            assert!(lo >= Rational::zero() && hi > Rational::zero());
+        }
+    }
+}
