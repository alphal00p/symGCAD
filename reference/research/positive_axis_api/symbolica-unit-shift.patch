+// Keep the pre-optimization fused recurrence as an independent comparator for
+// both the unit path and the unchanged non-unit path.
+fn unit_shift_fused_reference<F: Ring>(
+    p: &super::UnivariatePolynomial<F>,
+    shift: &F::Element,
+) -> super::UnivariatePolynomial<F> {
+    let mut result = p.clone();
+    for k in 0..p.degree() {
+        for j in (k..p.degree()).rev() {
+            let (left, right) = result.coefficients.split_at_mut(j + 1);
+            p.ring.add_mul_assign(&mut left[j], &right[0], shift);
+        }
+    }
+    result
+}
