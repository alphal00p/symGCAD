+    #[test]
+    fn resultant_linear_operand_has_sylvester_sign() {
+        let (x, y) = symbol!("x", "y");
+        let vars = Arc::new(vec![x.into(), y.into()]);
+        let cubic = parse!("x^3+y")
+            .to_polynomial::<_, u8>(&Q, Some(vars.clone())).to_univariate(0);
+        let linear = parse!("x+2")
+            .to_polynomial::<_, u8>(&Q, Some(vars.clone())).to_univariate(0);
+        let expected = parse!("8-y").to_polynomial::<_, u8>(&Q, Some(vars.clone()));
+        assert_eq!(cubic.resultant(&linear), expected);
+        assert_eq!(cubic.resultant_brown(&linear), expected);
+        assert_eq!(cubic.resultant_primitive(&linear), expected);
+        assert_eq!(cubic.resultant_ducos_integer(&linear), expected);
+        assert_eq!(cubic.resultant_crt(&linear), expected);
+        assert_eq!(cubic.resultant_auto(&linear), expected);
+        assert_eq!(linear.resultant(&cubic), -expected);
+
+        let first = parse!("2*x+y")
+            .to_polynomial::<_, u8>(&Q, Some(vars.clone())).to_univariate(0);
+        let second = parse!("3*x+1")
+            .to_polynomial::<_, u8>(&Q, Some(vars.clone())).to_univariate(0);
+        let determinant = parse!("2-3*y").to_polynomial::<_, u8>(&Q, Some(vars));
+        assert_eq!(first.resultant(&second), determinant);
+        assert_eq!(second.resultant(&first), -determinant);
     }
 
     #[test]
