+    #[test]
+    fn research_wang_nonmonomial_lcoeff_preserves_signed_reconstruction() {
+        // Run with SYMBOLICA_RESEARCH_SMALL_LC_WANG=1; otherwise this would
+        // exercise the historical random path instead of the admission change.
+        assert!(std::env::var_os("SYMBOLICA_RESEARCH_SMALL_LC_WANG").is_some());
+        let _lock = GLOBAL_FACTOR_SETTINGS_LOCK.lock().unwrap();
+        let _guard = FactorSettingsGuard::new();
+        GLOBAL_SETTINGS
+            .use_univariate_factorization
+            .store(true, Ordering::Relaxed);
+        GLOBAL_SETTINGS
+            .use_bivariate_factorization
+            .store(true, Ordering::Relaxed);
+        let polynomial = dense_bivariate_wang_test_polynomial().shift_var(1, &Integer::one());
+        assert!(polynomial.univariate_lcoeff(0).nterms() > 1);
+        for source in [polynomial.clone(), -polynomial.clone()] {
+            BIVARIATE_SAMPLE_FACTORIZATIONS.with(|count| count.set(0));
+            BIVARIATE_WANG_SAMPLE_TRIES.with(|count| count.set(0));
+            let mut order = vec![0, 1, 2];
+            let (factors, _, _, _, leading) = source.find_sample(&mut order, 10, None);
+            assert_eq!(factors.len(), 2);
+            assert!(leading.is_some());
+            BIVARIATE_SAMPLE_FACTORIZATIONS.with(|count| assert_eq!(count.get(), 1));
+            let (unit, lcs) = leading.unwrap();
+            let replay = lcs.iter().fold(source.constant(unit), |p, f| &p * f);
+            assert_eq!(replay, source.univariate_lcoeff(0));
+            let mut order = vec![0, 1, 2];
+            let exact = source.multivariate_factorization(&mut order, 10, None, None, false);
+            let replay = exact.iter().fold(source.one(), |p, f| &p * f);
+            assert_eq!(replay, source);
+        }
+        // An existing factor-count bound must still suppress the new shortcut.
+        let mut order = vec![0, 1, 2];
+        let (_, _, _, _, leading) = polynomial.find_sample(&mut order, 10, Some(2));
+        assert!(leading.is_none());
+    }
