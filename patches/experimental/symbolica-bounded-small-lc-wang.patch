+    #[test]
+    fn research_wang_public_factor_keeps_parameter_only_content() {
+        let variables = Some(Arc::new(vec![
+            symbol!("x").into(),
+            symbol!("y").into(),
+            symbol!("z").into(),
+        ]));
+        let source = parse!("(z-1)*((y+1)*x^3+y+z)")
+            .expand()
+            .to_polynomial::<_, u8>(&Z, variables);
+        let content = parse!("z-1").to_polynomial::<_, u8>(&Z, source.variables().clone());
+        let factors = source.factor();
+        assert!(
+            factors
+                .iter()
+                .any(|(f, m)| *m == 1 && (*f == content || *f == -content.clone()))
+        );
+        let replay = factors
+            .iter()
+            .fold(source.one(), |p, (f, m)| &p * &f.pow(*m));
+        assert_eq!(replay, source);
+    }
